IMAGE_TOOLS_API_GLOBAL_PREFIX=
IMAGE_TOOLS_API_TOKENS=

# FTP Configuration for image upload
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PATH=/

# Azure Blob Storage Configuration
AZURE_BLOB_STORAGE_CONNECTION_STRING=

# Image Processing Configuration
MAX_UPLOAD_MB=10
# Validate HTTPS URLs in image-process endpoint (set to 'true' for production)
IMAGE_PROCESS_VALIDATE_HTTPS_URL=false
LOG_LEVEL=DEBUG